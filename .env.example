# Copy to .env and fill in your values
SERVER_PORT=8080
SERVER_MODE=development

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=finance_tracker
DATABASE_SSL_MODE=disable

# Logging Configuration
# Mode: "development" (colored, human-readable) or "production" (JSON, structured)
SERVER_MODE=development

# Note: Log level is controlled by SERVER_MODE
# - development: debug level enabled
# - production: info level and above

# API Keys for exchange rate providers
# Get your free API key at: https://www.goldapi.io/
GOLDAPI_KEY=goldapi-b5yismn2bbos9-io

# Rate Scheduler Configuration
# How often to fetch exchange rates (min: 1m)
# Examples: "15m", "30m", "1h", "6h"
RATE_FETCH_INTERVAL=30m

# Maximum time for a single fetch before timeout (min: 10s)
# Examples: "30s", "1m", "2m", "5m"
RATE_FETCH_TIMEOUT=2m
